# ---- Supabase (Project Settings -> API) ----
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Never expose to the browser. Used by trusted API routes / seeding.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Demo one-click quick-login accounts. Default: ON in development, OFF in
# production. Set to "true" to enable provisioning in a deployed environment.
ALLOW_QUICK_LOGIN=true

# ---- AI Providers (server-only) ----
# Automated routing recommendations & Bill of Lading parsing.
# Provide at least one. The app prefers GROQ, then GEMINI.
GROQ_API_KEY=
GEMINI_API_KEY=

# Optional model overrides
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_MODEL=gemini-2.0-flash
